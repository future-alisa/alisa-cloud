{
  "apiVersion": "gateway.networking.k8s.io/v1",
  "kind": "HTTPRoute",
  "metadata": {
    "name": "alisa-admin",
    "namespace": "alisa-infra",
    "annotations": {
      "argocd.argoproj.io/sync-wave": "20"
    }
  },
  "spec": {
    "parentRefs": [
      {
        "name": "traefik-gateway",
        "namespace": "traefik"
      }
    ],
    "hostnames": [
      "alisa.vip.cpolar.cn"
    ],
    "rules": [
      {
        "matches": [
          {
            "path": {
              "type": "Exact",
              "value": "/admin"
            }
          }
        ],
        "filters": [
          {
            "type": "RequestRedirect",
            "requestRedirect": {
              "path": {
                "type": "ReplaceFullPath",
                "replaceFullPath": "/admin/"
              },
              "statusCode": 302
            }
          }
        ]
      },
      {
        "matches": [
          {
            "path": {
              "type": "PathPrefix",
              "value": "/admin"
            }
          }
        ],
        "filters": [
          {
            "type": "URLRewrite",
            "urlRewrite": {
              "path": {
                "type": "ReplacePrefixMatch",
                "replacePrefixMatch": "/"
              }
            }
          }
        ],
        "backendRefs": [
          {
            "name": "alisa-admin-web",
            "port": 8080
          }
        ]
      },
      {
        "matches": [
          {
            "path": {
              "type": "Exact",
              "value": "/alisa-gateway/api/v1/user/tenancy"
            },
            "method": "GET"
          }
        ],
        "filters": [
          {
            "type": "URLRewrite",
            "urlRewrite": {
              "path": {
                "type": "ReplaceFullPath",
                "replaceFullPath": "/api/v1/user/tenancy"
              }
            }
          }
        ],
        "backendRefs": [
          {
            "name": "alisa-admin-web",
            "port": 8080
          }
        ]
      },
      {
        "matches": [
          {
            "path": {
              "type": "Exact",
              "value": "/alisa-gateway/api/v1/user/tenancy"
            },
            "method": "OPTIONS"
          }
        ],
        "filters": [
          {
            "type": "URLRewrite",
            "urlRewrite": {
              "path": {
                "type": "ReplaceFullPath",
                "replaceFullPath": "/api/v1/user/tenancy"
              }
            }
          }
        ],
        "backendRefs": [
          {
            "name": "alisa-admin-web",
            "port": 8080
          }
        ]
      },
      {
        "matches": [
          {
            "path": {
              "type": "PathPrefix",
              "value": "/alisa-gateway/api/v1/user/tenants"
            },
            "method": "GET"
          }
        ],
        "filters": [
          {
            "type": "URLRewrite",
            "urlRewrite": {
              "path": {
                "type": "ReplacePrefixMatch",
                "replacePrefixMatch": "/api/v1/user/tenants"
              }
            }
          }
        ],
        "backendRefs": [
          {
            "name": "alisa-admin-web",
            "port": 8080
          }
        ]
      },
      {
        "matches": [
          {
            "path": {
              "type": "PathPrefix",
              "value": "/alisa-gateway/api/v1/user/tenants"
            },
            "method": "POST"
          }
        ],
        "filters": [
          {
            "type": "URLRewrite",
            "urlRewrite": {
              "path": {
                "type": "ReplacePrefixMatch",
                "replacePrefixMatch": "/api/v1/user/tenants"
              }
            }
          }
        ],
        "backendRefs": [
          {
            "name": "alisa-admin-web",
            "port": 8080
          }
        ]
      },
      {
        "matches": [
          {
            "path": {
              "type": "PathPrefix",
              "value": "/alisa-gateway/api/v1/user/tenants"
            },
            "method": "OPTIONS"
          }
        ],
        "filters": [
          {
            "type": "URLRewrite",
            "urlRewrite": {
              "path": {
                "type": "ReplacePrefixMatch",
                "replacePrefixMatch": "/api/v1/user/tenants"
              }
            }
          }
        ],
        "backendRefs": [
          {
            "name": "alisa-admin-web",
            "port": 8080
          }
        ]
      }
    ]
  }
}
